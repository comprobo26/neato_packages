<?xml version="1.0" ?>
<sdf version="1.9">
  <world name="default">
    <!-- A global light source -->
    <light name="sun" type="directional">
      <cast_shadows>true</cast_shadows>
      <direction>-0.5 0.2 -1</direction>
      <diffuse>1 1 1 1</diffuse>
    </light>
    <include>
      <uri>model://bod_volcano</uri>
    </include>
    <include>
      <uri>model://bod</uri>
    </include>
    <include>
      <uri>model://neato</uri>
    </include>
  </world>
</sdf>
